{
  "name": "backendrelay-www",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "dev:dash": "vite dev --config start.vite.config.mts --port 3002",
    "dev:site": "astro dev --config astro.config.mjs --port 3000",
    "build": "vite build --config start.vite.config.mts && astro build --config astro.config.mjs",
    "check": "tsc --noEmit",
    "check:site": "astro check",
    "format": "prettier --write --ignore-path .prettierignore --ignore-path ../.gitignore --ignore-path ../../.gitignore \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check-format": "prettier --check --ignore-path .prettierignore --ignore-path ../.gitignore --ignore-path ../../.gitignore \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "start": "node .output/server/index.mjs",
    "start:site": "node dist-site/server/entry.mjs",
    "test": "node --import tsx --test scripts/*.test.ts && vitest run",
    "test:dashboard": "tsx scripts/dashboard-regression.ts",
    "test:ci": "node --import tsx --test scripts/*.test.ts && vitest run",
    "test:components": "vitest run",
    "test:image-endpoint": "node scripts/astro-image-endpoint-regression.mjs"
  },
  "dependencies": {
