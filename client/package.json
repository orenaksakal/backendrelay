{
  "name": "backendrelay-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "BackendRelay client SDKs, website, and dashboard",
  "packageManager": "pnpm@10.34.9",
  "workspaces": {
    "packages": [
      "sandbox/*",
      "packages/*",
      "www",
      "dashboard"
    ]
  },
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo --no-update-notifier",
    "dev": "turbo run dev --filter=@instantdb/version --filter=@instantdb/core --filter=@instantdb/react-common --filter=@instantdb/react --filter=@instantdb/react-native --filter=@instantdb/admin --filter=@instantdb/platform --filter=@instantdb/react-native-mmkv --filter=@instantdb/expo-sqlite --filter=backendrelay-www --filter=@instantdb/components --filter=instant-cli --filter=@instantdb/resumable-stream --filter=@instantdb/webhooks --concurrency=20 --no-update-notifier",
    "test": "turbo run test:ci --no-update-notifier",
    "clean": "turbo run clean",
    "bench": "turbo run bench:ci --no-update-notifier",
    "format": "prettier --write --ignore-path .prettierignore --ignore-path ../.gitignore \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check-format": "prettier --check --ignore-path .prettierignore --ignore-path ../.gitignore \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build-packages": "turbo run build --filter=\"./packages/*\" --cache-dir=.turbo --no-update-notifier",
    "build-sandbox": "turbo run build --filter=\"./sandbox/*\" --cache-dir=.turbo --no-update-notifier",
    "test:local": "turbo run test:ci --filter=!@instantdb/core --no-update-notifier && pnpm --filter @instantdb/core run test:unit && pnpm --filter @instantdb/core run test:types && node scripts/mobile-dependency-contracts.test.cjs && node --test scripts/publish-packages.test.mjs"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "msw": "^2.14.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tsx": "^4.19.3",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3",
    "ws": "^8.21.3"
  },
