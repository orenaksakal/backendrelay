ARG OCI_SOURCE=https://github.com/orenaksakal/backendrelay
ARG OCI_REVISION=unknown

# Build on the host platform for any target: the dashboard bundle is
# architecture-independent. Its only native option is Astro's optional sharp
# image dependency, which this app never loads (astro.config.mjs uses the
# passthrough image service and disables the image endpoint); @vercel/og renders
# through wasm. The runtime stage stays on the target platform.
FROM --platform=$BUILDPLATFORM node:26.12.1-slim@sha256:94816674c62774da0d099a947bf4613b9e1972a2733abd0d0cd80e795f8411d0 AS dependencies

WORKDIR /monorepo

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches ./patches


# Install project dependencies with frozen lockfile for reproducible builds
RUN corepack enable pnpm && pnpm install --frozen-lockfile

FROM --platform=$BUILDPLATFORM node:26.12.1-slim@sha256:94816674c62774da0d099a947bf4613b9e1972a2733abd0d0cd80e795f8411d0 AS pruner

WORKDIR /monorepo

COPY --from=dependencies /monorepo/node_modules ./node_modules

COPY . .
RUN corepack enable pnpm;
RUN pnpm turbo prune backendrelay-www --docker

FROM --platform=$BUILDPLATFORM node:26.12.1-slim@sha256:94816674c62774da0d099a947bf4613b9e1972a2733abd0d0cd80e795f8411d0 AS builder
WORKDIR /monorepo
ARG NEXT_PUBLIC_SELF_HOSTED=true
ENV NEXT_PUBLIC_SELF_HOSTED=${NEXT_PUBLIC_SELF_HOSTED}
COPY --from=pruner /monorepo/out/json/ .
COPY --from=pruner /monorepo/patches ./patches
RUN corepack enable pnpm
RUN pnpm install --frozen-lockfile

COPY --from=pruner /monorepo/out/full/ .
COPY tsconfig.base.json ./

RUN pnpm install --frozen-lockfile

# Keep the build heap bounded while allowing the dashboard bundle to exceed
# Node 22's default 2 GiB heap. This environment applies only to the build.
RUN NODE_OPTIONS=--max-old-space-size=4096 \
    pnpm turbo run build --filter=backendrelay-www... --env-mode=loose

# Production runner
FROM node:26.12.1-slim@sha256:94816674c62774da0d099a947bf4613b9e1972a2733abd0d0cd80e795f8411d0 AS runner
WORKDIR /app

ARG OCI_SOURCE
ARG OCI_REVISION
LABEL org.opencontainers.image.source="$OCI_SOURCE"
LABEL org.opencontainers.image.revision="$OCI_REVISION"

ENV NODE_ENV=production
ENV INSTANT_API_URI=
ENV INSTANT_BACKEND_URL=
ARG NEXT_PUBLIC_SELF_HOSTED=true
ENV NEXT_PUBLIC_SELF_HOSTED=${NEXT_PUBLIC_SELF_HOSTED}

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Keep the pruned workspace layout: Astro externalizes dependencies and workspace
# packages remain reachable through pnpm's symlinks at runtime.
COPY --from=builder --chown=nextjs:nodejs /monorepo/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /monorepo/packages ./packages
COPY --from=builder --chown=nextjs:nodejs /monorepo/www/node_modules ./www/node_modules
COPY --from=builder --chown=nextjs:nodejs /monorepo/www/.output ./www/.output
COPY --from=builder --chown=nextjs:nodejs /monorepo/www/dist-site ./www/dist-site
COPY --from=builder --chown=nextjs:nodejs /monorepo/www/public ./www/public

COPY <<'EOF' /app/launcher.mjs
import { spawn } from 'node:child_process';

const processes = [
  spawn(process.execPath, ['/app/www/.output/server/index.mjs'], {
    env: { ...process.env, PORT: '3002', HOST: '127.0.0.1' },
    stdio: 'inherit',
  }),
  spawn(process.execPath, ['/app/www/dist-site/server/entry.mjs'], {
    env: {
      ...process.env,
      PORT: '3000',
      HOST: '::',
      INSTANT_START_ORIGIN: 'http://127.0.0.1:3002',
    },
    stdio: 'inherit',
  }),
];

let stopping = false;
function stop(exitCode) {
  if (stopping) return;
  stopping = true;
  process.exitCode = exitCode;
  for (const child of processes) child.kill('SIGTERM');
  setTimeout(() => {
    for (const child of processes) child.kill('SIGKILL');
  }, 10_000).unref();
}

for (const child of processes) {
  child.once('exit', (code, signal) => stop(code ?? (signal ? 1 : 0)));
  child.once('error', () => stop(1));
}
for (const signal of ['SIGINT', 'SIGTERM']) {
  process.on(signal, () => stop(0));
}
EOF

COPY <<'EOF' /app/start.sh
#!/bin/sh
set -eu

cd /app/www

node <<'NODE'
const fs = require('fs');

const apiURI = (
  process.env.INSTANT_API_URI ||
  process.env.INSTANT_BACKEND_URL ||
  ''
).trim();
const sentryDSN = (process.env.NEXT_PUBLIC_SENTRY_DSN || '').trim();

try {
  const url = new URL(apiURI);
  if (url.protocol !== 'http:' && url.protocol !== 'https:') {
    throw new Error('Unsupported protocol');
  }
} catch (_e) {
  console.error(
    'INSTANT_API_URI or INSTANT_BACKEND_URL must be a valid HTTP(S) URL.',
  );
  process.exit(1);
}

fs.writeFileSync(
  '/app/www/.output/public/publicSelfHostedVariables.js',
  `window.__instantConfig = ${JSON.stringify({ apiURI, sentryDSN })};\n`,
);
fs.writeFileSync(
  '/app/www/dist-site/client/publicSelfHostedVariables.js',
  `window.__instantConfig = ${JSON.stringify({ apiURI, sentryDSN })};\n`,
);
NODE

exec node /app/launcher.mjs
EOF

RUN chmod +x /app/start.sh

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["/app/start.sh"]
