  "cel": [
    {
      "name": "has requires a field selection",
      "source": "has(1)",
      "expected": "compile-error"
    },
    {
      "name": "standard macro arity is checked at compile time",
      "source": "[1].all()",
      "expected": "compile-error"
    },
    {
      "name": "division by zero propagates as an evaluation error",
      "source": "1 / 0 == 0",
      "expected": "evaluation-error"
    },
    {
      "name": "false suppresses an error on the left of and",
      "source": "(1 / 0 == 0) && false",
      "expected": "false"
    },
    {
      "name": "true suppresses an error on the left of or",
      "source": "(1 / 0 == 0) || true",
      "expected": "true"
    },
    {
      "name": "empty all uses the macro identity",
      "source": "[].all(value, value > 0)",
      "expected": "true"
    },
    {
      "name": "empty exists one uses the macro identity",
      "source": "[].exists_one(value, value > 0)",
      "expected": "false"
    }
  ],
  "persisted": [
