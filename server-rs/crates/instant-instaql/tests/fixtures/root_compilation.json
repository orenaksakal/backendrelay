  "cases": [
    {
      "name": "default-created-at-page",
      "admin": false,
      "query": {"users": {"$": {"limit": 2, "offset": 1}}},
      "expected": {
        "kind": "success",
        "limit": 2,
        "offset": 1,
        "order_attr": "11111111-1111-1111-1111-111111111111",
