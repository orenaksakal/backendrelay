    {
      "name": "admin-count",
      "admin": true,
      "query": {"users": {"$": {"aggregate": "count"}}},
      "expected": {
        "kind": "success",
        "limit": null,
        "offset": null,
        "order_attr": null,
        "order_type": null,
        "aggregate": "count"
      }
    },
    {
      "name": "mutually-exclusive-limits",
      "admin": false,
      "query": {"users": {"$": {"first": 1, "last": 1}}},
      "expected": {
        "kind": "error",
        "expected": "supported-options?",
        "path": ["users", "$"],
        "message_contains": "Only provide one"
      }
    },
    {
      "name": "unchecked-order",
      "admin": false,
      "query": {"users": {"$": {"order": {"unchecked": "asc"}}}},
      "expected": {
        "kind": "error",
        "expected": "supported-order?",
        "path": ["users", "$", "order"],
        "message_contains": "is not indexed"
      }
    },
    {
      "name": "non-admin-count",
      "admin": false,
      "query": {"users": {"$": {"aggregate": "count"}}},
      "expected": {
        "kind": "error",
        "expected": "admin?",
        "path": ["users", "$", "aggregate"],
        "message_contains": "only available for admin"
      }
    }
