    {
      "name": "checked-last-page",
      "admin": false,
      "query": {"users": {"$": {"last": 3, "order": {"handle": "desc"}}}},
      "expected": {
        "kind": "success",
        "limit": 3,
        "offset": null,
        "order_attr": "22222222-2222-2222-2222-222222222222",
        "order_type": "string",
        "aggregate": null
