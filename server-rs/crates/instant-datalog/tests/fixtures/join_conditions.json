[
  {
    "name": "joins symbols to every prior binding",
    "source": "server/test/instant/db/datalog_test.clj:82-92",
    "patterns": [
      {
        "index": { "key": "vae" },
        "components": [
          { "kind": "variable", "value": "?a" },
          { "kind": "variable", "value": "?b" },
          { "kind": "variable", "value": "?c" }
        ]
      },
      {
        "index": { "key": "ea" },
        "components": [
          { "kind": "variable", "value": "?c" },
          { "kind": "variable", "value": "?d" },
          { "kind": "variable", "value": "?e" }
        ]
      },
      {
        "index": { "key": "ea" },
        "components": [
          { "kind": "variable", "value": "?b" },
          { "kind": "variable", "value": "?c" }
        ]
      }
    ],
    "expected": [
      [
        [":=", ":entity-id", [":json_uuid_to_uuid", ":match-0-value"]]
      ],
      [
        [":=", ":entity-id", ":match-0-attr-id"],
        [":=", ":attr-id", [":json_uuid_to_uuid", ":match-0-value"]],
        [":=", ":attr-id", ":match-1-entity-id"]
      ]
    ]
  },
  {
    "name": "joins JSON values directly",
    "source": "server/test/instant/db/datalog_test.clj:93-97",
    "patterns": [
      {
        "index": { "key": "eav" },
        "components": [
          { "kind": "any" },
          { "kind": "any" },
          { "kind": "variable", "value": "?a" }
        ]
      },
      {
        "index": { "key": "av" },
        "components": [
          { "kind": "any" },
          { "kind": "any" },
          { "kind": "variable", "value": "?a" }
        ]
      }
    ],
    "expected": [
      [[":=", ":value", ":match-0-value"]]
    ]
  },
  {
    "name": "coerces a VAE origin value to UUID",
    "source": "server/test/instant/db/datalog_test.clj:98-100",
    "patterns": [
      {
        "index": { "key": "ea" },
        "components": [
          { "kind": "variable", "value": "?a" }
        ]
      },
      {
        "index": { "key": "vae" },
        "components": [
          { "kind": "any" },
          { "kind": "any" },
          { "kind": "variable", "value": "?a" }
        ]
      }
    ],
    "expected": [
      [[":=", [":json_uuid_to_uuid", ":value"], ":match-0-entity-id"]]
    ]
  },
  {
    "name": "joins entity to attribute",
    "source": "server/test/instant/db/datalog_test.clj:101-103",
    "patterns": [
      {
        "index": { "key": "av" },
        "components": [
          { "kind": "any" },
          { "kind": "variable", "value": "?a" }
        ]
      },
      {
        "index": { "key": "ea" },
        "components": [
          { "kind": "variable", "value": "?a" }
        ]
      }
    ],
    "expected": [
      [[":=", ":entity-id", ":match-0-attr-id"]]
    ]
  },
  {
    "name": "joins attribute to entity",
    "source": "server/test/instant/db/datalog_test.clj:104-105",
    "patterns": [
      {
        "index": { "key": "ea" },
        "components": [
          { "kind": "variable", "value": "?a" }
        ]
      },
      {
        "index": { "key": "av" },
        "components": [
          { "kind": "any" },
          { "kind": "variable", "value": "?a" }
        ]
      }
    ],
    "expected": [
      [[":=", ":attr-id", ":match-0-entity-id"]]
    ]
  }
]

