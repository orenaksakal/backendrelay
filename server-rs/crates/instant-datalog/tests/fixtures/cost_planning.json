        {
          "kind": "function",
          "value": {
            "function": "comparator",
            "argument": {
              "operation": "$gte",
              "data_type": "number",
              "value": 18
            }
          }
        }
      ]
    },
    "options": {
      "attribute_cardinalities": {
        "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb": 100
      }
    },
    "expected_index": "triples_number_type_idx"
  },
