[
  {
    "name": "small bound entity set beats a million-row checked date scan",
    "source": "server/src/instant/db/datalog.clj:1522-1705",
    "pattern": {
      "index": { "key": "ave", "data_type": "date" },
      "components": [
        { "kind": "variable", "value": "?entity" },
        { "kind": "constant", "value": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb" },
        {
          "kind": "function",
          "value": {
            "function": "comparator",
            "argument": {
              "operation": "$gt",
              "data_type": "date",
              "value": "2026-01-01T00:00:00Z"
            }
          }
        }
      ]
    },
    "options": {
      "attribute_cardinalities": {
        "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb": 1000000
      }
    },
    "symbol_cardinalities": { "?entity": 12 },
    "expected_index": "triples_pkey"
  },
  {
