{
  "uid": "backendrelay-single-vps",
  "title": "BackendRelay single VPS",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "backendrelay-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, surface) (rate(backendrelay_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{surface}}{{consumer}}{{job}}{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Request errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "backendrelay-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (surface) (rate(backendrelay_http_requests_total{status_class=\"5xx\"}[5m]))",
          "legendFormat": "{{surface}}{{consumer}}{{job}}{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
