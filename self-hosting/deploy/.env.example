# Deployment kit environment for BackendRelay (self-hosting/deploy).
#
# Copy this file to self-hosting/deploy/.env, fill in every required value and
# run `chmod 600` on it. deploy.sh refuses a group- or world-readable file.
# Never commit the filled file. Every image below must be a digest-only
# reference (`registry/repository@sha256:<64 lowercase hex>`); tags are rejected
# for the server and dashboard by verify-release-images.sh, and the other
# images are pinned the same way so a redeploy cannot change them silently.
#
# The server keysets do not belong here. Generate them once with
# `instant-server generate-secrets` into the `server_secrets` volume and keep
# an age-encrypted copy off host; see docs/operations.md#secrets.

# ---------------------------------------------------------------------------
# Public origin and TLS
# ---------------------------------------------------------------------------
# Cloudflare proxies these hostnames to this host. The origin certificate is a
# Cloudflare origin certificate (or any certificate valid for both names).
BACKEND_DOMAIN=api.example.com
DASHBOARD_DOMAIN=dash.example.com
INSTANT_BACKEND_URL=https://api.example.com
INSTANT_DASHBOARD_URL=https://dash.example.com
# Exact public object-store origin used by dashboard previews. No paths.
INSTANT_STORAGE_ORIGIN=https://files.example.com
# Realtime WebSocket origin allowed by the dashboard CSP. Without it the
# browser blocks live data.
BR_WS_ORIGIN=wss://api.example.com
# Keep OAuth and session cookies secure on the public HTTPS origin.
INSTANT_SECURE_COOKIES=true
# Host directory containing origin.pem and origin-key.pem, mounted read-only at
# /etc/caddy/tls. For the local dry run use ./deploy/tls.
DEPLOY_TLS_DIR=/etc/backendrelay/tls
TLS_CERT_FILE=/etc/caddy/tls/origin.pem
TLS_KEY_FILE=/etc/caddy/tls/origin-key.pem
# Required only for Caddyfile.letsencrypt-dns and a Caddy image built with the
# caddy-dns/cloudflare module. Leave blank when using the origin certificate.
CLOUDFLARE_DNS_API_TOKEN=
CADDY_EMAIL=
# Selects the mounted edge configuration. Caddyfile is the origin-certificate
# default; use Caddyfile.letsencrypt-dns for the DNS-01 alternative.
CADDY_CONFIG_FILE=./deploy/Caddyfile
# Host ports for the edge. The staging project on the same host must use other
# values (its .env.staging.example uses 8080/8443) because production owns
# 80/443. Cloudflare reaches a non-default staging port through an Origin Rule.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Optional body-limit overrides understood by the Caddyfiles.
CADDY_MAX_RESTORE_BODY=1100MB
CADDY_MAX_UPLOAD_BODY=110MB
CADDY_MAX_MANAGEMENT_BODY=2MB
CADDY_MAX_REQUEST_BODY=8MB

# ---------------------------------------------------------------------------
# Container images (digest-only)
# ---------------------------------------------------------------------------
# deploy.sh overrides the server and dashboard digests with its arguments; the
# values here are the first-deploy fallback and what manual compose commands
# use. Copy the canonical digest references from the CI release artifact.
INSTANT_SERVER_IMAGE=registry.example.com/backendrelay/server@sha256:REPLACE_WITH_64_LOWERCASE_HEX
INSTANT_DASHBOARD_IMAGE=registry.example.com/backendrelay/dashboard@sha256:REPLACE_WITH_64_LOWERCASE_HEX
# Built from self-hosting/postgres (PostgreSQL 17, wal2json, pg_hint_plan,
# pgBackRest) and used by both postgres and aux-postgres.
INSTANT_POSTGRES_IMAGE=registry.example.com/backendrelay/postgres@sha256:REPLACE_WITH_64_LOWERCASE_HEX
# Caddy 2.11.x. Use the DNS-enabled build only with Caddyfile.letsencrypt-dns.
CADDY_IMAGE=registry.example.com/library/caddy@sha256:REPLACE_WITH_64_LOWERCASE_HEX
# Node 24 slim image for the one-shot SDK smoke query.
DEPLOY_SMOKE_IMAGE=registry.example.com/library/node@sha256:REPLACE_WITH_64_LOWERCASE_HEX
# BackendRelay canary image, started by the monitoring overlay's canary profile.
CANARY_IMAGE=registry.example.com/backendrelay/canary@sha256:REPLACE_WITH_64_LOWERCASE_HEX

# ---------------------------------------------------------------------------
# Fixed compose network and client IPs
# ---------------------------------------------------------------------------
# Caddy resolves the Cloudflare client address and sends it as X-Forwarded-For.
# The server trusts exactly this subnet through INSTANT_TRUSTED_PROXY_CIDRS, so
# per-IP limits and request.ip rules see the public client, not Caddy. Keep the
# five addresses inside the subnet. The staging project on the same host needs
# its own subnet, network name and addresses; see .env.staging.example.
DEPLOY_SUBNET=172.30.0.0/24
DEPLOY_NETWORK_NAME=backendrelay
CADDY_IP=172.30.0.2
SERVER_IP=172.30.0.3
# Address for the one-off migration container; must differ from SERVER_IP so
# it can run while the server is serving. Defaults to 172.30.0.250.
DEPLOY_MIGRATE_IP=172.30.0.250
DASHBOARD_IP=172.30.0.4
AUX_POSTGRES_IP=172.30.0.5
POSTGRES_IP=172.30.0.6

# ---------------------------------------------------------------------------
# Production database (postgres) and staging database (aux-postgres)
# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD belongs to the postgres superuser used by pgBackRest and
# recovery.py. The server connects as the separate unprivileged role below.
# Use URL-safe characters only: letters, digits, '.', '_', '~' and '-'.
POSTGRES_PASSWORD=
POSTGRES_DB=instant
INSTANT_DB_USER=instant
INSTANT_DB_PASSWORD=
# The staging database lives in its own volume and never holds production data.
AUX_POSTGRES_PASSWORD=
AUX_POSTGRES_DB=staging
AUX_DB_USER=staging
AUX_DB_PASSWORD=
# PostgreSQL memory sizing. Defaults assume about 32 GB of RAM shared with the
# server and monitoring; adjust to the host.
INSTANT_PG_SHARED_BUFFERS=6GB
INSTANT_PG_EFFECTIVE_CACHE_SIZE=16GB
INSTANT_PG_SHM_SIZE=1gb
# No container CPU or memory caps: services use the host's capacity. Size the
# PostgreSQL settings below for the host, not for a container quota.
# Main pool size per server process. Keep max_connections (200) above
# CONNECTION_POOL_SIZE times the server replica count plus auxiliary pools.
CONNECTION_POOL_SIZE=20
# Continuous WAL archiving is opt-in; configure pgbackrest.env first.
INSTANT_PG_ARCHIVE_MODE=off
INSTANT_PG_ARCHIVE_TIMEOUT=60

# ---------------------------------------------------------------------------
# Object storage (R2 in production, MinIO in the local dry run)
# ---------------------------------------------------------------------------
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Explicit endpoints so the same stack runs against R2, MinIO or another
# S3-compatible service. R2 example:
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Local dry run:
#   S3_ENDPOINT=http://minio:9000
#   S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_VIRTUAL_HOST_STYLE=false
S3_FILES_BUCKET=instantdb-files
S3_BACKUPS_BUCKET=instantdb-backups

# ---------------------------------------------------------------------------
# Server limits, retention and metrics
# ---------------------------------------------------------------------------
# Blank keeps the server default. Set values here to freeze them per deployment.
INSTANT_MAX_LIVE_SESSIONS_PER_IP=
INSTANT_MAX_SUBSCRIPTIONS_PER_SESSION=
INSTANT_MAX_INSTAQL_QUERY_BYTES=
INSTANT_STORAGE_MAX_UPLOAD_BYTES=
INSTANT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=
INSTANT_MAGIC_CODE_RATE_LIMIT_PER_IP_HOUR=
INSTANT_MAGIC_CODE_VERIFY_LIMIT_PER_IP_HOUR=
INSTANT_MAGIC_CODE_DAILY_LIMIT_PER_APP=
INSTANT_HISTORY_RETENTION_DAYS=
INSTANT_TRANSACTION_RETENTION_DAYS=
# Loopback-only metrics unless the monitoring overlay widens the bind.
INSTANT_METRICS_ADDR=127.0.0.1:9091
INSTANT_METRICS_ALLOW_NONLOOPBACK=false
# Server, dashboard and Caddy also run without container CPU/memory caps.

# ---------------------------------------------------------------------------
# Dashboard access and email
# ---------------------------------------------------------------------------
# Signup is closed unless you explicitly choose otherwise. Restrict dashboard
# access to the owner account before the first production deploy.
INSTANT_DASHBOARD_SIGNUP=closed
INSTANT_DASHBOARD_ALLOWED_EMAILS=owner@example.com
INSTANT_EPHEMERAL_APPS=false
# Optional private gateway mode. Set only after the gateway is verified.
INSTANT_DASHBOARD_PRIVATE=
INSTANT_DASHBOARD_GATEWAY_TOKEN=
# Optional: the dashboard gateway origin when it is separate from
# INSTANT_DASHBOARD_URL. Blank disables gateway mode.
INSTANT_DASHBOARD_API_URL=
# Optional deployment superuser. Restart the server after changing it.
INSTANT_SUPERUSER_EMAIL=owner@example.com
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=
# Cloudflare Email Sending is the shipped provider.
INSTANT_EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
INSTANT_TRANSACTIONAL_EMAIL_SENDER_EMAIL=login@example.com
INSTANT_DASHBOARD_EMAIL_SENDER_NAME=Instant
INSTANT_DASHBOARD_EMAIL_SENDER_EMAIL=login@example.com
INSTANT_APP_EMAIL_SENDER_NAME=Instant
INSTANT_APP_EMAIL_SENDER_EMAIL=login@example.com
INSTANT_TEAM_EMAIL_SENDER_NAME=Instant
INSTANT_TEAM_EMAIL_SENDER_EMAIL=login@example.com
# Legacy providers stay available when selected explicitly.
POSTMARK_TOKEN=
POSTMARK_ACCOUNT_TOKEN=
SENDGRID_TOKEN=
RESEND_TOKEN=
# Optional Sentry-protocol error reporting; Bugsink can be self-hosted.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Optional nightly per-app backups; blank keeps the profile default.
INSTANT_NIGHTLY_APP_BACKUPS=

# ---------------------------------------------------------------------------
# Backups and deploy behaviour
# ---------------------------------------------------------------------------
# recovery.py configuration. The deploy aborts when this file is missing or
# the backup command fails. The systemd backup unit uses the same file.
DEPLOY_RECOVERY_CONFIG=/etc/backendrelay/backup.json
# Optional alternative backup command, for a managed PostgreSQL provider.
# DEPLOY_BACKUP_COMMAND=pscale backup create <branch>
DEPLOY_STATE_DIR=/var/lib/backendrelay/deploy
# Select the env file from the shell only; a value inside this file is too late.
# DEPLOY_ENV_FILE=/opt/backendrelay/self-hosting/deploy/.env
# production (default) or staging. deploy.sh derives the database service and
# the compose profile from it; the staging project has its own env file, see
# .env.staging.example.
DEPLOY_STACK=production
# Database service for this stack. deploy.sh and rollback.sh set it from
# DEPLOY_STACK and refuse a file that disagrees; listed here for manual compose
# commands, which must use the same value.
DEPLOY_DB_SERVICE=postgres
DEPLOY_COMPOSE_PROJECT=backendrelay
DEPLOY_HEALTH_TIMEOUT_SECONDS=60
DEPLOY_SMOKE_TIMEOUT_SECONDS=30
# One server replica to start. A later server-b service is restarted one at a
# time by listing it here and adding it to the Caddy upstream.
DEPLOY_SERVER_SERVICES=server
# Caddy upstream list. Add server-b:8888 only after the second replica exists
# and the database connection budget can absorb its pool.
SERVER_UPSTREAMS=server:8888
# 1 when Cloudflare proxies the origin (production); 0 for a direct edge;
# local skips the public-address assertions for the Docker dry run.
DEPLOY_EXPECT_CLOUDFLARE=1
# Public origin for the smoke test. Blank derives https://$BACKEND_DOMAIN.
DEPLOY_SMOKE_API_URL=
# Set to 1 only for the first deploy, before the canary app exists (P7.6).
DEPLOY_SKIP_CANARY_SMOKE=0
# Set to 1 only on a brand-new, empty database. There is nothing to back up
# yet; every later deploy must take a verified backup.
DEPLOY_FIRST_DEPLOY=0
# 1 merges the monitoring overlay. It then requires every variable below.
DEPLOY_MONITORING=0
# auto rolls back migrations that the target binary cannot serve; never aborts.
ROLLBACK_MIGRATE_DOWN=auto

# ---------------------------------------------------------------------------
# Canary and monitoring overlay (required when DEPLOY_MONITORING=1)
# ---------------------------------------------------------------------------
# The canary app is created in P7.6. Its admin token lives in a root-owned
# mode-600 file on the host, outside the repository.
CANARY_API_URL=https://api.example.com
CANARY_APP_ID=
CANARY_ADMIN_TOKEN_FILE=/etc/backendrelay/canary-admin-token
CANARY_HEALTHCHECK_URL=
CANARY_INTERVAL_SECONDS=60
CANARY_TIMEOUT_SECONDS=10
PROMETHEUS_IMAGE=registry.example.com/prometheus/prometheus@sha256:REPLACE_WITH_64_LOWERCASE_HEX
ALERTMANAGER_IMAGE=registry.example.com/prometheus/alertmanager@sha256:REPLACE_WITH_64_LOWERCASE_HEX
GRAFANA_IMAGE=registry.example.com/grafana/grafana@sha256:REPLACE_WITH_64_LOWERCASE_HEX
NODE_EXPORTER_IMAGE=registry.example.com/prometheus/node-exporter@sha256:REPLACE_WITH_64_LOWERCASE_HEX
POSTGRES_EXPORTER_IMAGE=registry.example.com/prometheus/postgres-exporter@sha256:REPLACE_WITH_64_LOWERCASE_HEX
LOKI_IMAGE=registry.example.com/grafana/loki@sha256:REPLACE_WITH_64_LOWERCASE_HEX
ALLOY_IMAGE=registry.example.com/grafana/alloy@sha256:REPLACE_WITH_64_LOWERCASE_HEX
DOCKER_SOCKET_PROXY_IMAGE=registry.example.com/tecnativa/docker-socket-proxy@sha256:REPLACE_WITH_64_LOWERCASE_HEX
BUGSINK_IMAGE=registry.example.com/bugsink/bugsink@sha256:REPLACE_WITH_64_LOWERCASE_HEX
PUSHOVER_USER_KEY_FILE=/etc/backendrelay/pushover-user-key
PUSHOVER_TOKEN_FILE=/etc/backendrelay/pushover-token
DEADMAN_WEBHOOK_FILE=/etc/backendrelay/deadman-webhook
GRAFANA_PASSWORD_FILE=/etc/backendrelay/grafana-password
POSTGRES_MONITOR_PASSWORD_FILE=/etc/backendrelay/postgres-monitor-password
MONITORING_TEXTFILE_DIR=/var/lib/node-exporter/textfile
BUGSINK_SECRET_KEY_FILE=/etc/backendrelay/bugsink.env
POSTGRES_EXPORTER_DSN=postgres:5432/instant?sslmode=disable
POSTGRES_EXPORTER_USER=backendrelay_monitor

# ---------------------------------------------------------------------------
# Local dry run only (docker-compose.dry-run.yml); never set in production
# ---------------------------------------------------------------------------
MINIO_IMAGE=registry.example.com/minio/minio@sha256:REPLACE_WITH_64_LOWERCASE_HEX
MINIO_MC_IMAGE=registry.example.com/minio/mc@sha256:REPLACE_WITH_64_LOWERCASE_HEX
