# Staging project environment for BackendRelay (P7.5).
#
# The staging stack is the same compose file in a second compose project on the
# same host: it has its own network and subnet, its own port bindings, its own
# volumes and `server_secrets` keysets, its own database in `aux-postgres` and
# its own object-storage buckets. Rehearse every release here with deploy.sh
# before the same digests reach production. See the staging section in README.md.
#
# Copy this file to self-hosting/deploy/.env.staging, fill in every value and
# run `chmod 600` on it. deploy.sh refuses a group- or world-readable file.
# Select it with DEPLOY_ENV_FILE=deploy/.env.staging; never commit the filled
# file. Images are digest-only, exactly as in production.
#
# The staging keysets do not belong here either. Generate them once with
# `instant-server generate-secrets` into the staging `server_secrets` volume;
# they are separate from production because Compose prefixes volume names with
# the project name.

# ---------------------------------------------------------------------------
# Public origin and TLS
# ---------------------------------------------------------------------------
# Cloudflare proxies these hostnames to this host. Use an origin certificate
# that covers both names, separate from the production certificate.
BACKEND_DOMAIN=staging-api.example.com
DASHBOARD_DOMAIN=staging-dash.example.com
INSTANT_BACKEND_URL=https://staging-api.example.com
INSTANT_DASHBOARD_URL=https://staging-dash.example.com
# Optional public origin of the staging files bucket for dashboard previews:
# an R2 custom domain such as https://staging-files.example.com, or the account
# endpoint. Blank leaves previews disabled.
INSTANT_STORAGE_ORIGIN=
# Realtime WebSocket origin allowed by the dashboard CSP.
BR_WS_ORIGIN=wss://staging-api.example.com
INSTANT_SECURE_COOKIES=true
# Host directory with the staging origin.pem and origin-key.pem, mounted
# read-only at /etc/caddy/tls.
DEPLOY_TLS_DIR=/etc/backendrelay/staging-tls
TLS_CERT_FILE=/etc/caddy/tls/origin.pem
TLS_KEY_FILE=/etc/caddy/tls/origin-key.pem
CLOUDFLARE_DNS_API_TOKEN=
CADDY_EMAIL=
CADDY_CONFIG_FILE=./deploy/Caddyfile
# Production owns host ports 80/443. Staging binds others; Cloudflare reaches
# them through an Origin Rule for the two staging hostnames, and the Hetzner
# Cloud Firewall must allow 8443 from Cloudflare's ranges.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
CADDY_MAX_RESTORE_BODY=1100MB
CADDY_MAX_UPLOAD_BODY=110MB
CADDY_MAX_MANAGEMENT_BODY=2MB
CADDY_MAX_REQUEST_BODY=8MB

# ---------------------------------------------------------------------------
# Container images (digest-only)
# ---------------------------------------------------------------------------
# Use the same digest-only references as production: the point of the staging
# rehearsal is to run exactly the images that will go live next.
INSTANT_SERVER_IMAGE=registry.example.com/backendrelay/server@sha256:REPLACE_WITH_64_LOWERCASE_HEX
INSTANT_DASHBOARD_IMAGE=registry.example.com/backendrelay/dashboard@sha256:REPLACE_WITH_64_LOWERCASE_HEX
INSTANT_POSTGRES_IMAGE=registry.example.com/backendrelay/postgres@sha256:REPLACE_WITH_64_LOWERCASE_HEX
CADDY_IMAGE=registry.example.com/library/caddy@sha256:REPLACE_WITH_64_LOWERCASE_HEX
DEPLOY_SMOKE_IMAGE=registry.example.com/library/node@sha256:REPLACE_WITH_64_LOWERCASE_HEX

# ---------------------------------------------------------------------------
# Stack identity: network, subnet, addresses, ports, state
# ---------------------------------------------------------------------------
# deploy.sh refuses DEPLOY_STACK=staging with the production project name,
# network name or state directory, so these must differ from .env.
DEPLOY_STACK=staging
DEPLOY_COMPOSE_PROJECT=backendrelay-staging
DEPLOY_NETWORK_NAME=backendrelay-staging
DEPLOY_SUBNET=172.31.0.0/24
CADDY_IP=172.31.0.2
SERVER_IP=172.31.0.3
# Address for the one-off migration container; must differ from SERVER_IP so
# it can run while the server is serving. Defaults to 172.31.0.250.
DEPLOY_MIGRATE_IP=172.31.0.250
DASHBOARD_IP=172.31.0.4
AUX_POSTGRES_IP=172.31.0.5
POSTGRES_IP=172.31.0.6
DEPLOY_STATE_DIR=/var/lib/backendrelay-staging/deploy

# ---------------------------------------------------------------------------
# Staging database (aux-postgres)
# ---------------------------------------------------------------------------
# The staging project never starts the production `postgres` service; its
# database lives in `aux-postgres`, in the `aux-db` volume. Compose still
# interpolates these two values for the unused production service and for the
# server's DATABASE_URL, so fill them in.
# POSTGRES_PASSWORD is unused by staging: set a throwaway URL-safe value, never
# the production password.
POSTGRES_PASSWORD=
# The server connects as INSTANT_DB_USER to POSTGRES_DB on aux-postgres, and
# aux-postgres creates that role and database from the AUX_* values, so the two
# pairs must match.
POSTGRES_DB=staging
INSTANT_DB_USER=staging
INSTANT_DB_PASSWORD=
AUX_POSTGRES_PASSWORD=
AUX_POSTGRES_DB=staging
AUX_DB_USER=staging
AUX_DB_PASSWORD=
# Keep the staging footprint small; the box also runs production. The unused
# `postgres` service gets small limits so an accidental bare `up` is cheap.
INSTANT_PG_SHARED_BUFFERS=256MB
INSTANT_PG_EFFECTIVE_CACHE_SIZE=1GB
INSTANT_PG_SHM_SIZE=128mb
# No container CPU or memory caps; staging and production share the host.
CONNECTION_POOL_SIZE=10
# Staging keeps no WAL archive and runs no pgBackRest stanza;
# staging-backup.sh dumps the database before each rehearsal deploy instead.
INSTANT_PG_ARCHIVE_MODE=off
INSTANT_PG_ARCHIVE_TIMEOUT=60

# ---------------------------------------------------------------------------
# Object storage (staging buckets in the same R2 account)
# ---------------------------------------------------------------------------
# The server has no key-prefix setting, so staging uses its own buckets with
# bucket-scoped tokens. Give the files bucket a CORS rule for the staging
# dashboard origin and its own custom domain or r2.dev hostname.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_VIRTUAL_HOST_STYLE=false
S3_FILES_BUCKET=instantdb-staging-files
S3_BACKUPS_BUCKET=instantdb-staging-backups

# ---------------------------------------------------------------------------
# Server limits, retention and metrics
# ---------------------------------------------------------------------------
# Staging should exercise the production limits. Copy the values from .env, or
# leave them blank to keep the server defaults.
INSTANT_MAX_LIVE_SESSIONS_PER_IP=
INSTANT_MAX_SUBSCRIPTIONS_PER_SESSION=
INSTANT_MAX_INSTAQL_QUERY_BYTES=
INSTANT_STORAGE_MAX_UPLOAD_BYTES=
INSTANT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=
INSTANT_MAGIC_CODE_RATE_LIMIT_PER_IP_HOUR=
INSTANT_MAGIC_CODE_VERIFY_LIMIT_PER_IP_HOUR=
INSTANT_MAGIC_CODE_DAILY_LIMIT_PER_APP=
INSTANT_HISTORY_RETENTION_DAYS=
INSTANT_TRANSACTION_RETENTION_DAYS=
# The monitoring overlay stays off on staging: its Grafana, exporters and log
# shipper are production-only and would collide on host ports and names.
DEPLOY_MONITORING=0
INSTANT_METRICS_ADDR=127.0.0.1:9091
INSTANT_METRICS_ALLOW_NONLOOPBACK=false
# No container CPU or memory caps.

# ---------------------------------------------------------------------------
# Dashboard access and email
# ---------------------------------------------------------------------------
# Keep staging private: closed signup and only the owner's address. Staging
# sends real email, so either reuse the platform sender or a staging domain and
# only ever sign in with the owner account.
INSTANT_DASHBOARD_SIGNUP=closed
INSTANT_DASHBOARD_ALLOWED_EMAILS=owner@example.com
INSTANT_EPHEMERAL_APPS=false
INSTANT_DASHBOARD_PRIVATE=
INSTANT_DASHBOARD_GATEWAY_TOKEN=
INSTANT_DASHBOARD_API_URL=
INSTANT_SUPERUSER_EMAIL=owner@example.com
INSTANT_EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
INSTANT_TRANSACTIONAL_EMAIL_SENDER_EMAIL=login@example.com
INSTANT_DASHBOARD_EMAIL_SENDER_NAME=BackendRelay staging
INSTANT_DASHBOARD_EMAIL_SENDER_EMAIL=login@example.com
INSTANT_APP_EMAIL_SENDER_NAME=BackendRelay staging
INSTANT_APP_EMAIL_SENDER_EMAIL=login@example.com
INSTANT_TEAM_EMAIL_SENDER_NAME=BackendRelay staging
INSTANT_TEAM_EMAIL_SENDER_EMAIL=login@example.com
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
INSTANT_NIGHTLY_APP_BACKUPS=

# ---------------------------------------------------------------------------
# Rehearsal deploy behaviour
# ---------------------------------------------------------------------------
# deploy.sh starts aux-postgres, runs this dump, migrates, restarts and runs the
# same smoke tests as production. The dump is local to the host and keeps the
# newest five; staging data is disposable and not backed up off host.
DEPLOY_DB_SERVICE=aux-postgres
DEPLOY_BACKUP_COMMAND=bash /opt/backendrelay/self-hosting/deploy/staging-backup.sh
STAGING_BACKUP_DIR=/var/lib/backendrelay-staging/backups
# Keep this at 0 even for the first run: dumping the empty staging database is
# cheap, and the dump waits for aux-postgres to accept connections before
# deploy.sh migrates.
DEPLOY_FIRST_DEPLOY=0
DEPLOY_HEALTH_TIMEOUT_SECONDS=60
DEPLOY_SMOKE_TIMEOUT_SECONDS=30
DEPLOY_SERVER_SERVICES=server
SERVER_UPSTREAMS=server:8888
DEPLOY_EXPECT_CLOUDFLARE=1
DEPLOY_SMOKE_API_URL=
# 1 only until a staging canary app and token exist (create both in the staging
# dashboard, then set CANARY_APP_ID and CANARY_ADMIN_TOKEN_FILE).
DEPLOY_SKIP_CANARY_SMOKE=0
ROLLBACK_MIGRATE_DOWN=auto

# ---------------------------------------------------------------------------
# Staging canary
# ---------------------------------------------------------------------------
CANARY_API_URL=https://staging-api.example.com
CANARY_APP_ID=
CANARY_ADMIN_TOKEN_FILE=/etc/backendrelay/staging-canary-admin-token
CANARY_HEALTHCHECK_URL=
CANARY_INTERVAL_SECONDS=60
CANARY_TIMEOUT_SECONDS=10
