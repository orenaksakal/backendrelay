# Production edge for the deployment kit. Cloudflare terminates the public TLS
# connection and Caddy presents a Cloudflare origin certificate. Firewall the
# host to Cloudflare's ranges (P7.3) so the origin only accepts proxied traffic.
# Replace this file with Caddyfile.letsencrypt-dns when Caddy owns the DNS-01
# challenge instead.
#
# Cloudflare ranges as of 2026-10-26, https://www.cloudflare.com/ips/
# Caddy only honours CF-Connecting-IP from these addresses, so a spoofed header
# sent through any other hop is ignored.
{
	admin off
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		# The server has a 30 s per-request timeout but no header-read timeout
		# (axum::serve). Cut slow clients here. No body timeout: restore uploads
		# can be large.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# Pre-authentication body limits. The server enforces the same limits; these
# stop oversized bodies before they cross the compose network. The dashboard
# restore upload and both storage upload routes are excluded from the 2 MB
# management cap (the server enforces 1 MiB on those routes).
(backend_body_limits) {
	@restore path /dash/restores/zip
	request_body @restore {
		max_size {$CADDY_MAX_RESTORE_BODY:1100MB}
	}

	@uploads path /dash/apps/*/storage/upload /admin/storage/upload /storage/upload
	request_body @uploads {
		max_size {$CADDY_MAX_UPLOAD_BODY:110MB}
	}

	@management {
		path /dash/* /admin/* /superadmin/*
		not path /dash/restores/zip /dash/apps/*/storage/upload /admin/storage/upload
	}
	request_body @management {
		max_size {$CADDY_MAX_MANAGEMENT_BODY:2MB}
	}

	@other {
		not path /dash/* /admin/* /superadmin/* /storage/*
	}
	request_body @other {
		max_size {$CADDY_MAX_REQUEST_BODY:8MB}
	}
}

{$BACKEND_DOMAIN:api.localhost} {
	tls {$TLS_CERT_FILE:/etc/caddy/tls/origin.pem} {$TLS_KEY_FILE:/etc/caddy/tls/origin-key.pem}
	import backend_body_limits
	log {
		output stdout
		format json
	}
	reverse_proxy {$SERVER_UPSTREAMS} {
		health_uri /health/system
		health_interval 10s
		health_timeout 5s
		health_status 200
		# Stream SSE without buffering; WebSocket upgrades keep working.
		flush_interval -1
		# Replace the chain instead of appending to it. The server trusts only
		# the compose subnet and walks this single public address.
		header_up X-Forwarded-For {client_ip}
	}
}

{$DASHBOARD_DOMAIN:dash.localhost} {
	tls {$TLS_CERT_FILE:/etc/caddy/tls/origin.pem} {$TLS_KEY_FILE:/etc/caddy/tls/origin-key.pem}
	encode zstd gzip
	log {
		output stdout
		format json
	}
	reverse_proxy dashboard:8080 {
		health_uri /healthz
		health_interval 10s
		health_timeout 5s
		health_status 200
		header_up X-Forwarded-For {client_ip}
	}
}
