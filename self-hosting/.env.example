# Public URLs. Change these when deploying behind a domain or proxy.
INSTANT_BACKEND_URL=http://localhost:8888
# Optional exact public object-store origin for dashboard image previews.
# Required for HTTP storage on a different origin; no paths or wildcards.
INSTANT_STORAGE_ORIGIN=
INSTANT_DASHBOARD_URL=http://localhost:3000
# Enable secure OAuth/session cookies when the backend URL is HTTPS.
INSTANT_SECURE_COOKIES=false
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
# Leave empty for direct access. `auto` resolves INSTANT_TRUSTED_PROXY_HOST
# (default `caddy`) to host routes. Coolify configures its private proxy ranges.
INSTANT_TRUSTED_PROXY_CIDRS=

# Optional runtime admission caps. Private client addresses are exempt from the
# per-IP session cap. Config-app flags with the same names (without INSTANT_ and
# lowercased with dashes) override these at startup.
# INSTANT_MAX_LIVE_SESSIONS_PER_IP=100
# INSTANT_MAX_SUBSCRIPTIONS_PER_SESSION=500
# INSTANT_MAX_INSTAQL_QUERY_BYTES=262144

# Domains used by the Caddy compose file. For production, point DNS at this host
# and update the public URLs above to use these domains with https://.
# These are only required if using docker-compose.with-caddy.yml
DASHBOARD_DOMAIN=localhost
BACKEND_DOMAIN=api.localhost

# Database. DATABASE_URL is inferred from these values inside docker-compose.
# POSTGRES_PASSWORD belongs to the postgres superuser, which pgBackRest and
# recovery.py use. The server connects as the unprivileged role below.
POSTGRES_PASSWORD=pleasegenerateapasswordhere
POSTGRES_DB=instant
INSTANT_DB_USER=instant
INSTANT_DB_PASSWORD=pleasegenerateapasswordhere
# Optional digest-pinned image built from self-hosting/postgres; unset builds it locally.
# INSTANT_POSTGRES_IMAGE=
# The number of connections each instance will create to the database
# Ensure that postgres' `max_connections` is greater than CONNECTION_POOL_SIZE*<num instances>
CONNECTION_POOL_SIZE=20
# PostgreSQL memory defaults for the production compose files. They assume a
# 32 GB host shared with the server and monitoring (about 25% and 50-60% of RAM).
# The local and test compose files ignore these and use 256MB/1GB.
# INSTANT_PG_SHARED_BUFFERS=6GB
# INSTANT_PG_EFFECTIVE_CACHE_SIZE=16GB
# Days of history partitions and transaction marker rows to keep. Positive
# integers only; leave unset for 30.
# INSTANT_HISTORY_RETENTION_DAYS=30
# INSTANT_TRANSACTION_RETENTION_DAYS=30

# Production/Swarm artifacts. Copy the canonical digest-only references from
# the CI release mapping artifact. Tags and Git SHA tags are rejected.
INSTANT_SERVER_IMAGE=
INSTANT_DASHBOARD_IMAGE=

# Cloudflare R2 object storage. `r2-wrangler.sh provision` creates both buckets
# through your Wrangler OAuth session; no access key is needed for that step.
# The server itself uses one Object Read & Write token restricted to both
# buckets. Never commit the token values; run `chmod 600 .env` after saving them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILES_BUCKET=instantdb-files
R2_BACKUPS_BUCKET=instantdb-backups

# PostgreSQL continuous WAL archiving with pgBackRest. Archive mode is off by
# default; enabling it retains every WAL segment until a working repository
# accepts them, so configure the repository before you restart with
# archive_mode=on. Repository settings and secrets live in pgbackrest.env;
# create it from pgbackrest.env.example and chmod 600. See
# self-hosting/backup/README.md.
INSTANT_PG_ARCHIVE_MODE=off
# Seconds without WAL activity before PostgreSQL forces an archive.
INSTANT_PG_ARCHIVE_TIMEOUT=60

# Optional private dashboard origin guard. Set only after the private gateway
# has been verified. Runtime/Admin SDK APIs remain public. Never set a blank key.
# INSTANT_DASHBOARD_PRIVATE=true
# INSTANT_DASHBOARD_GATEWAY_TOKEN=<secret shared only by API and private gateway>
# INSTANT_DASHBOARD_ALLOWED_EMAILS=owner@example.com
# Closed by default; set open only when anyone with email may create an account.
# INSTANT_DASHBOARD_SIGNUP=closed
# Off by default; enables unauthenticated POST /dash/apps/ephemeral.
# INSTANT_EPHEMERAL_APPS=false
# Unset keeps nightly per-app backups off in this profile; true enables them.
# INSTANT_NIGHTLY_APP_BACKUPS=false
#
# Optional Sentry-protocol error reporting, for example a self-hosted Bugsink.
# The server reports panics and error events; the dashboard reports browser
# errors. Both stay off when their DSN is blank. See docs/operations.md.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_DSN=
#
# Optional realtime canary (monitoring overlay profile `canary`). Create a
# dedicated app, put its admin token in a root-owned mode-600 file, and point
# CANARY_ADMIN_TOKEN_FILE at that host file. See docs/operations.md.
# CANARY_API_URL=https://api.example.com
# CANARY_APP_ID=
# CANARY_ADMIN_TOKEN_FILE=/etc/backendrelay/canary-admin-token
# CANARY_HEALTHCHECK_URL=
# CANARY_INTERVAL_SECONDS=60
# CANARY_TIMEOUT_SECONDS=10
# CANARY_IMAGE=
#
# Optional deployment superuser. This user can manage the entire self-hosted
# deployment. Restart the server after changing it.
INSTANT_SUPERUSER_EMAIL=

# Dashboard Google login. Create a Google OAuth Web application and set its
# authorized redirect URI to ${INSTANT_BACKEND_URL}/dash/oauth/callback.
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_ID=
INSTANT_DASHBOARD_GOOGLE_OAUTH_CLIENT_SECRET=

# Email. Cloudflare is the BackendRelay transactional provider.
# Set the account, Email Sending token, and default sender below before startup.
# For legacy installations, explicitly select postmark or sendgrid instead.
# With the provider blank and no legacy tokens, delivery is disabled and codes
# are logged; do not use that configuration for production app authentication.
POSTMARK_TOKEN=
# Postmark account token for creating and inspecting custom app sender signatures.
# Subject/body edits that keep an existing sender address and name do not require it.
POSTMARK_ACCOUNT_TOKEN=
SENDGRID_TOKEN=
# Optional alternative: INSTANT_EMAIL_PROVIDER=resend and a verified sender.
RESEND_TOKEN=
# Recommended for BackendRelay: cloudflare. Requires the three settings below.
INSTANT_EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# An address on a domain enabled for Cloudflare Email Sending.
# Apps keep their app display name and send from this shared transactional address.
INSTANT_TRANSACTIONAL_EMAIL_SENDER_EMAIL=
INSTANT_DASHBOARD_EMAIL_SENDER_NAME=Instant
INSTANT_DASHBOARD_EMAIL_SENDER_EMAIL=
INSTANT_APP_EMAIL_SENDER_NAME=Instant
INSTANT_APP_EMAIL_SENDER_EMAIL=
INSTANT_TEAM_EMAIL_SENDER_NAME=Instant
INSTANT_TEAM_EMAIL_SENDER_EMAIL=
