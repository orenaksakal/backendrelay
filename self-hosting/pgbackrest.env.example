# pgBackRest repository settings for the postgres service.
#
# Copy to pgbackrest.env and lock it down:
#   cp pgbackrest.env.example pgbackrest.env
#   chmod 600 pgbackrest.env
# Never commit pgbackrest.env. Compose includes it when it exists, so only the
# variables you put here reach the container; omit an optional setting instead
# of leaving it empty, because pgBackRest rejects empty values.

# Repo 1 is Cloudflare R2; s3 selects the S3-compatible backend.
PGBACKREST_REPO1_TYPE=s3
# https://<account>.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_ENDPOINT=
# R2 uses the auto region.
PGBACKREST_REPO1_S3_REGION=auto
# Path-style addressing works with R2.
PGBACKREST_REPO1_S3_URI_STYLE=path
# Bucket-scoped bucket, key, and secret.
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# An optional prefix inside the bucket.
PGBACKREST_REPO1_PATH=/pgbackrest
# Encrypt every backup at rest with this repository passphrase.
PGBACKREST_REPO1_CIPHER_TYPE=aes-256-cbc
PGBACKREST_REPO1_CIPHER_PASS=
# Keep 14 days of full backups and their dependents.
PGBACKREST_REPO1_RETENTION_FULL_TYPE=time
PGBACKREST_REPO1_RETENTION_FULL=14

# Optional repo 2 (Backblaze B2 or Hetzner Object Storage). Uncomment the whole
# block to enable it; never leave a repo2 variable defined but empty.
# PGBACKREST_REPO2_TYPE=s3
# PGBACKREST_REPO2_S3_ENDPOINT=
# PGBACKREST_REPO2_S3_REGION=auto
# PGBACKREST_REPO2_S3_URI_STYLE=path
# PGBACKREST_REPO2_S3_BUCKET=
# PGBACKREST_REPO2_S3_KEY=
# PGBACKREST_REPO2_S3_KEY_SECRET=
# PGBACKREST_REPO2_PATH=/pgbackrest
# PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
# PGBACKREST_REPO2_CIPHER_PASS=
# PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
# PGBACKREST_REPO2_RETENTION_FULL=14
